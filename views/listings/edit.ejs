<% layout("/layouts/boilerplate") -%>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h1 class="mb-4 text-center">Edit Listing</h1>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
        
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input 
            name="listing[title]" 
            id="title"
            class="form-control" 
            type="text" 
            value="<%= listing.title %>" 
            required
          />
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea 
            name="listing[description]" 
            id="description"
            class="form-control" 
            rows="4"
            required
          ><%= listing.description %></textarea>
        </div>

        <!-- Current Image -->
        <div class="mb-3">
          <label class="form-label d-block">Current Image</label>
          <img src="<%= listing.image.url %>" class="img-fluid rounded" alt="Listing Image" style="max-height: 250px;" />
        </div>

        <!-- Upload New Image -->
        <div class="mb-3">
          <label for="image-filename" class="form-label">Upload New Image</label>
          <input 
            name="image" 
            id="image-filename"
            class="form-control" 
            type="file" 
            accept="image/*"
          />
        </div>

        <!-- Price and Country -->
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input 
              name="listing[price]" 
              id="price"
              class="form-control" 
              type="number"
              required 
              value="<%= listing.price %>"
            />
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input 
              name="listing[country]" 
              id="country"
              class="form-control" 
              type="text" 
              required
              value="<%= listing.country %>"
            />
          </div>
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input 
            name="listing[location]" 
            id="location"
            class="form-control" 
            type="text" 
            required
            value="<%= listing.location %>"
          />
        </div>

        <!-- Submit Button -->
        <div class="text-center">
          <button type="submit" class="btn btn-dark add-btn">Update Listing</button>
        </div>
      </form>
    </div>
  </div>
</div>
